import 'package:cloud_firestore/cloud_firestore.dart';
import 'package:firebase_auth/firebase_auth.dart';
import 'package:flutter/material.dart';

import 'package:asistencia_qr/core/theme/app_theme.dart';
import 'package:asistencia_qr/core/widgets/fondo_vinotinto.dart';

class MiAsistenciaScreen extends StatelessWidget {
  const MiAsistenciaScreen({super.key});

  @override
  Widget build(BuildContext context) {
    return const _AsistenciaEstudianteContenido(mostrarResumen: true);
  }
}

class HistorialEstudianteScreen extends StatelessWidget {
  const HistorialEstudianteScreen({super.key});

  @override
  Widget build(BuildContext context) {
    return const _AsistenciaEstudianteContenido(mostrarResumen: false);
  }
}

class _AsistenciaEstudianteContenido extends StatelessWidget {
  final bool mostrarResumen;

  const _AsistenciaEstudianteContenido({required this.mostrarResumen});

  String _fecha(dynamic valor) {
    if (valor is! Timestamp) return 'Fecha no disponible';

    final fecha = valor.toDate();
    final dia = fecha.day.toString().padLeft(2, '0');
    final mes = fecha.month.toString().padLeft(2, '0');
    final anio = fecha.year;
    final hora = fecha.hour.toString().padLeft(2, '0');
    final minuto = fecha.minute.toString().padLeft(2, '0');

    return '$dia/$mes/$anio · $hora:$minuto';
  }

  DateTime _obtenerFecha(dynamic valor) {
    if (valor is Timestamp) return valor.toDate();
    return DateTime(2000);
  }

  Widget _mensaje(String texto) {
    return Center(
      child: Container(
        margin: const EdgeInsets.all(20),
        padding: const EdgeInsets.all(22),
        decoration: BoxDecoration(
          color: crema,
          borderRadius: BorderRadius.circular(18),
        ),
        child: Text(
          texto,
          textAlign: TextAlign.center,
          style: const TextStyle(color: vinotintoMedio, fontSize: 14),
        ),
      ),
    );
  }

  Widget _tarjetaResumen(String titulo, String valor, IconData icono) {
    return Expanded(
      child: Container(
        padding: const EdgeInsets.symmetric(vertical: 17, horizontal: 10),
        decoration: BoxDecoration(
          color: crema,
          borderRadius: BorderRadius.circular(16),
        ),
        child: Column(
          children: [
            Icon(icono, color: verde, size: 27),
            const SizedBox(height: 8),
            Text(
              valor,
              style: const TextStyle(
                color: verde,
                fontSize: 23,
                fontWeight: FontWeight.bold,
              ),
            ),
            const SizedBox(height: 4),
            Text(
              titulo,
              textAlign: TextAlign.center,
              style: const TextStyle(color: vinotintoMedio, fontSize: 11),
            ),
          ],
        ),
      ),
    );
  }

  Widget _tarjetaAsistencia(
    Map<String, dynamic> datos,
    Map<String, String> nombresClases,
  ) {
    final claseId = datos['claseId']?.toString() ?? '';
    final nombreClase =
        nombresClases[claseId] ?? datos['claseNombre']?.toString() ?? 'Clase';

    final salon = datos['salon']?.toString() ?? 'No especificado';
    final estado = datos['estado']?.toString() ?? 'Presente';

    return Card(
      color: crema,
      elevation: 2,
      margin: const EdgeInsets.only(bottom: 12),
      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
      child: Padding(
        padding: const EdgeInsets.all(16),
        child: Row(
          children: [
            Container(
              padding: const EdgeInsets.all(12),
              decoration: BoxDecoration(
                color: verde.withValues(alpha: 0.10),
                borderRadius: BorderRadius.circular(13),
              ),
              child: const Icon(
                Icons.check_circle_rounded,
                color: verde,
                size: 27,
              ),
            ),
            const SizedBox(width: 13),
            Expanded(
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text(
                    nombreClase,
                    style: const TextStyle(
                      color: verde,
                      fontWeight: FontWeight.bold,
                      fontSize: 14,
                    ),
                  ),
                  const SizedBox(height: 5),
                  Text(
                    'Salón: $salon',
                    style: const TextStyle(color: vinotintoMedio, fontSize: 12),
                  ),
                  const SizedBox(height: 4),
                  Text(
                    _fecha(datos['fechaRegistro']),
                    style: const TextStyle(color: vinotintoMedio, fontSize: 11),
                  ),
                ],
              ),
            ),
            const SizedBox(width: 8),
            Column(
              children: [
                const Icon(Icons.verified_rounded, color: verde, size: 21),
                const SizedBox(height: 4),
                Text(
                  estado,
                  style: const TextStyle(
                    color: verde,
                    fontWeight: FontWeight.bold,
                    fontSize: 11,
                  ),
                ),
              ],
            ),
          ],
        ),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    final usuario = FirebaseAuth.instance.currentUser;

    if (usuario == null) {
      return const Scaffold(body: Center(child: Text('Debes iniciar sesión.')));
    }

    final db = FirebaseFirestore.instance;

    final asistenciasStream = db
        .collection('asistencias')
        .where('estudianteId', isEqualTo: usuario.uid)
        .snapshots();

    final inscripcionesStream = db
        .collection('inscripciones')
        .where('estudianteId', isEqualTo: usuario.uid)
        .snapshots();

    return Scaffold(
      appBar: AppBar(
        title: Text(
          mostrarResumen ? 'Mi asistencia' : 'Historial de asistencia',
          style: const TextStyle(fontWeight: FontWeight.bold),
        ),
        backgroundColor: crema,
        foregroundColor: verde,
      ),
      body: FondoVinotinto(
        child: SafeArea(
          child: StreamBuilder<QuerySnapshot<Map<String, dynamic>>>(
            stream: asistenciasStream,
            builder: (context, asistenciasSnapshot) {
              if (asistenciasSnapshot.hasError) {
                return _mensaje(
                  'No se pudieron consultar tus asistencias. '
                  'Verifica los permisos de Firestore.',
                );
              }

              if (!asistenciasSnapshot.hasData) {
                return const Center(
                  child: CircularProgressIndicator(color: crema),
                );
              }

              final asistencias = asistenciasSnapshot.data!.docs.toList();

              asistencias.sort((a, b) {
                return _obtenerFecha(b.data()['fechaRegistro'])
                    .compareTo(_obtenerFecha(a.data()['fechaRegistro']));
              });

              return StreamBuilder<QuerySnapshot<Map<String, dynamic>>>(
                stream: inscripcionesStream,
                builder: (context, inscripcionesSnapshot) {
                  if (inscripcionesSnapshot.hasError) {
                    return _mensaje(
                      'No se pudieron consultar los datos de tus clases.',
                    );
                  }

                  if (!inscripcionesSnapshot.hasData) {
                    return const Center(
                      child: CircularProgressIndicator(color: crema),
                    );
                  }

                  final nombresClases = <String, String>{};

                  for (final inscripcion in inscripcionesSnapshot.data!.docs) {
                    final datos = inscripcion.data();
                    final claseId = datos['claseId']?.toString();
                    final nombre = datos['claseNombre']?.toString();

                    if (claseId != null &&
                        nombre != null &&
                        nombre.isNotEmpty) {
                      nombresClases[claseId] = nombre;
                    }
                  }

                  final clasesConAsistencia = asistencias
                      .map((doc) => doc.data()['claseId']?.toString())
                      .where((id) => id != null && id.isNotEmpty)
                      .toSet()
                      .length;

                  final contenido = mostrarResumen
                      ? asistencias.take(5).toList()
                      : asistencias;

                  return ListView(
                    padding: const EdgeInsets.all(18),
                    children: [
                      Text(
                        mostrarResumen
                            ? 'MI RESUMEN DE ASISTENCIA'
                            : 'REGISTROS ANTERIORES',
                        style: const TextStyle(
                          color: crema,
                          fontSize: 13,
                          fontWeight: FontWeight.bold,
                          letterSpacing: 1.3,
                        ),
                      ),
                      const SizedBox(height: 8),
                      Text(
                        mostrarResumen
                            ? 'Consulta tus registros y revisa cómo va tu asistencia.'
                            : 'Aquí puedes consultar todas tus asistencias registradas, '
                                  'desde la más reciente hasta la más antigua.',
                        style: const TextStyle(
                          color: crema,
                          fontSize: 13,
                          height: 1.5,
                        ),
                      ),
                      const SizedBox(height: 20),

                      if (mostrarResumen) ...[
                        Row(
                          children: [
                            _tarjetaResumen(
                              'Asistencias',
                              asistencias.length.toString(),
                              Icons.fact_check_rounded,
                            ),
                            const SizedBox(width: 10),
                            _tarjetaResumen(
                              'Clases',
                              clasesConAsistencia.toString(),
                              Icons.menu_book_rounded,
                            ),
                          ],
                        ),
                        const SizedBox(height: 22),
                        const Text(
                          'ASISTENCIAS RECIENTES',
                          style: TextStyle(
                            color: crema,
                            fontSize: 13,
                            fontWeight: FontWeight.bold,
                            letterSpacing: 1.2,
                          ),
                        ),
                        const SizedBox(height: 12),
                      ] else ...[
                        Container(
                          padding: const EdgeInsets.all(15),
                          decoration: BoxDecoration(
                            color: crema,
                            borderRadius: BorderRadius.circular(15),
                          ),
                          child: Row(
                            children: [
                              const Icon(
                                Icons.history_rounded,
                                color: verde,
                                size: 27,
                              ),
                              const SizedBox(width: 12),
                              Expanded(
                                child: Text(
                                  '${asistencias.length} registros encontrados',
                                  style: const TextStyle(
                                    color: verde,
                                    fontWeight: FontWeight.bold,
                                  ),
                                ),
                              ),
                            ],
                          ),
                        ),
                        const SizedBox(height: 18),
                      ],

                      if (asistencias.isEmpty)
                        _mensaje(
                          'Todavía no tienes asistencias registradas. '
                          'Cuando escanees un código QR válido, '
                          'tus registros aparecerán aquí.',
                        )
                      else
                        ...contenido.map(
                          (doc) =>
                              _tarjetaAsistencia(doc.data(), nombresClases),
                        ),

                      if (mostrarResumen && asistencias.length > 5)
                        Padding(
                          padding: const EdgeInsets.only(top: 5),
                          child: Text(
                            'Hay ${asistencias.length - 5} registros más '
                            'en tu historial.',
                            textAlign: TextAlign.center,
                            style: const TextStyle(color: crema, fontSize: 12),
                          ),
                        ),

                      const SizedBox(height: 15),
                      const Center(
                        child: Text(
                          'Asistencia Virtual',
                          style: TextStyle(
                            color: crema,
                            fontWeight: FontWeight.w600,
                            fontSize: 12,
                          ),
                        ),
                      ),
                    ],
                  );
                },
              );
            },
          ),
        ),
      ),
    );
  }
}
